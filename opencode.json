{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CONTRIBUTING.md",
    "docs/guidelines.md",
    ".kilo/rules/*.md",
    ".kilo/skills/*.md"
  ],
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },

    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "ctx7sk-aeec615d-518c-4a5f-a21c-765773be48e8"
      },
      "enabled": true
    },
    "sequentialthinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "better-auth": {
      "type": "remote",
      "url": "https://mcp.better-auth.com/mcp"
    },
    "agent-platform-mcp": {
      "type": "remote",
      "url": "https://aiplatform.googleapis.com/mcp/generate"
    },
    "google-maps-platform-code-assist": {
      "type": "local",
      "command": ["npx", "-y", "@googlemaps/code-assist-mcp@0.2.0"]
    },

    "didit": {
      "type": "remote",
      "url": "https://mcp.didit.me/mcp"
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=wfaimkpvgzfbptztbcsu&read_only=true&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "3929868d-b65e-4bf3-90ee-f346f25c2c94"
      }
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp-oauth"
    }
  }
}
