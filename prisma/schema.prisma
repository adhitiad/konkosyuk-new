  created_at         DateTime         @default(now()) @db.Timestamp(6)
  updated_at         DateTime         @default(now()) @db.Timestamp(6)
  bookings           Booking          @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "Payment_booking_id_Booking_id_fk")

  @@index([booking_id])
  @@index([status_pembayaran])
}

model KycRequest {
