  @@map("platform_config")
}

model PaymentTransaction {
  id               String          @id @default(cuid())
  tipeTransaksi    TipeTransaksi
  jumlah           Decimal         @db.Decimal(12, 2)
  status           StatusTransaksi @default(PENDING)
  referensiGateway String?
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  bookingDP        Booking?        @relation("BookingDP")
  bookingPelunasan Booking?        @relation("BookingPelunasan")
  bookingRefund    Booking?        @relation("BookingRefund")

  @@index([tipeTransaksi])
  @@index([status])
}

model Transaction {
  id                     String           @id @default(cuid())
  bookingId              String           @db.Uuid @unique
  amount                 Int
  paymentMethod          String?
  midtransOrderId        String           @unique
  midtransTransactionId  String?
  status                 TransactionStatus @default(PENDING)
  webhookPayload         Json?
  created_at             DateTime         @default(now()) @db.Timestamp(6)
  updated_at             DateTime         @default(now()) @db.Timestamp(6)
  booking                Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bookingId])
  @@index([status])
  @@index([midtransOrderId])
}

model Property {
