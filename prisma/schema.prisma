model Booking {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_id              String            @db.Uuid
  penyewa_id           String            @db.Uuid
  tanggal_mulai        DateTime          @db.Timestamp(6)
  tanggal_selesai      DateTime          @db.Timestamp(6)
  total_harga          Decimal           @db.Decimal(12, 2)
  status_booking       StatusBooking     @default(PENDING_PAYMENT)
  jumlahDP             Decimal           @default(0) @db.Decimal(12, 2)
  jumlahPelunasan      Decimal           @default(0) @db.Decimal(12, 2)
  tanggalBayarDP       DateTime?         @db.Timestamp(6)
  tanggalPelunasan     DateTime?         @db.Timestamp(6)
  tanggalDitolak       DateTime?         @db.Timestamp(6)
  alasanPenolakan      String?
  statusRefundDP       StatusRefundDP?   @default(BELUM_REFUND)
  transaksiDP_id       String?           @unique
  transaksiPelunasan_id String?          @unique
  transaksiRefund_id   String?           @unique
  payment_deadline     DateTime          @db.Timestamp(6)
  cancelled_at         DateTime?         @db.Timestamp(6)
  cancelled_reason     String?
  rental_period        BookingRentalPeriod
  check_in_date        DateTime          @db.Timestamp(6)
  check_out_date       DateTime          @db.Timestamp(6)
  previous_booking_id  String?           @db.Uuid @unique
  next_booking_id      String?           @db.Uuid @unique
  created_at           DateTime          @default(now()) @db.Timestamp(6)
  updated_at           DateTime          @default(now()) @db.Timestamp(6)
  units                units             @relation("Booking_unit_id", fields: [unit_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "Booking_unit_id_units_id_fk")
  users                users             @relation("Booking_penyewa", fields: [penyewa_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "Booking_penyewa_id_users_id_fk")
  payments             Payment[]
  refund_requests      RefundRequest[]
  transaksiDP          PaymentTransaction? @relation("BookingDP", fields: [transaksiDP_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  transaksiPelunasan   PaymentTransaction? @relation("BookingPelunasan", fields: [transaksiPelunasan_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  transaksiRefund      PaymentTransaction? @relation("BookingRefund", fields: [transaksiRefund_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  transaction          Transaction?
  previousBooking      Booking?           @relation("BookingExtension", fields: [previous_booking_id], references: [id], onDelete: NoAction, map: "Booking_previous_booking_id_Booking_id_fk")
  nextBooking          Booking?           @relation("BookingExtension", map: "Booking_next_booking_id_Booking_id_fk")
  conversation         Conversation?      @relation("BookingConversation")

  @@index([penyewa_id])
  @@index([unit_id])
  @@index([transaksiDP_id])
  @@index([transaksiPelunasan_id])
  @@index([transaksiRefund_id])
  @@index([previous_booking_id])
  @@index([next_booking_id])
}

model Payment {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id         String           @db.Uuid
