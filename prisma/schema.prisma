generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  id                       String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id                  String    @db.Uuid
  account_id               String
  provider_id              String
  access_token             String?
  refresh_token            String?
  id_token                 String?
  access_token_expires_at  DateTime? @db.Timestamp(6)
  refresh_token_expires_at DateTime? @db.Timestamp(6)
  expires_at               DateTime? @db.Timestamp(6)
  password                 String?
  scope                    String?
  created_at               DateTime  @default(now()) @db.Timestamp(6)
  updated_at               DateTime  @default(now()) @db.Timestamp(6)
  issuer                   String?
  users                    users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "accounts_user_id_users_id_fk")

  @@index([provider_id, account_id], map: "accounts_provider_idx")
  @@index([user_id])
}

model ad_packages {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String                @unique(map: "ad_packages_name_unique")
  label         String
  tier          AdPackageTier
  duration      Int
  price         Decimal               @db.Decimal(12, 2)
  position_type AdPackagePositionType
  sort_order    Int                   @default(0)
  is_active     Boolean               @default(true)
  created_at    DateTime              @default(now()) @db.Timestamp(6)
  property_ads  property_ads[]

  @@index([is_active], map: "idx_ad_packages_active")
  @@index([tier], map: "idx_ad_packages_tier")
}

model analytics_events {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?  @db.Uuid
  session_id String?
  event      String
  properties Json?    @default("{}")
  user_agent String?
  ip_address String?
  referrer   String?
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "analytics_events_user_id_users_id_fk")

  @@index([created_at], map: "idx_analytics_events_created")
  @@index([event], map: "idx_analytics_events_event")
  @@index([user_id], map: "idx_analytics_events_user")
}

model app_settings {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique(map: "app_settings_key_unique")
  value       String
  is_secret   Boolean  @default(false)
  description String?
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)

  @@index([key])
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id    String?  @db.Uuid
  action      String
  target_type String
  target_id   String
  details     Json?    @default("{}")
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  users       users?   @relation(fields: [admin_id], references: [id], onUpdate: NoAction, map: "audit_logs_admin_id_users_id_fk")
}

model balance_logs {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?        @db.Uuid
  amount      Decimal        @db.Decimal(12, 2)
  type        BalanceLogType
  description String
  related_id  String?
  created_at  DateTime       @default(now()) @db.Timestamp(6)
  updated_at  DateTime       @default(now()) @db.Timestamp(6)
  users       users?         @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "balance_logs_user_id_users_id_fk")

  @@index([created_at])
  @@index([type])
  @@index([user_id])
}

model booking_requests {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String?              @db.Uuid
  unit_id       String               @db.Uuid
  property_id   String               @db.Uuid
  num_occupants Int
  start_date    DateTime             @db.Timestamp(6)
  status        BookingRequestStatus @default(pending)
  agreed_price  Decimal?             @db.Decimal(12, 2)
  created_at    DateTime             @default(now()) @db.Timestamp(6)
  updated_at    DateTime             @default(now()) @db.Timestamp(6)
  properties    properties           @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "booking_requests_property_id_properties_id_fk")
  users         users?               @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "booking_requests_tenant_id_users_id_fk")
  units         units                @relation(fields: [unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "booking_requests_unit_id_units_id_fk")
  bookings      bookings?            @relation("booking_request_to_booking")

  @@index([property_id])
  @@index([status])
  @@index([tenant_id])
  @@index([unit_id])
}

model bookings {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String?                 @db.Uuid
  property_id            String                  @db.Uuid
  unit_id                String                  @db.Uuid
  booking_type           BookingType
  status                 BookingStatus           @default(pending_dp)
  start_date             DateTime                @db.Timestamp(6)
  end_date               DateTime                @db.Timestamp(6)
  metadata               Json?                   @default("{}")
  rejection_reason       String?
  is_group_booking       Boolean?                @default(false)
  group_booking_id       String?                 @db.Uuid
  pricing_rule_id        String?                 @db.Uuid
  base_price_at_booking  Decimal?                @db.Decimal(12, 2)
  security_deposit       Decimal?                @db.Decimal(12, 2)
  move_in_inspection_id  String?                 @db.Uuid
  move_out_inspection_id String?                 @db.Uuid
  inspection_status      InspectionStatus        @default(pending)
  booking_request_id     String?                 @unique @db.Uuid
  discount_amount        Decimal?                @default(0) @db.Decimal(12, 2)
  tax_amount             Decimal?                @default(0) @db.Decimal(12, 2)
  total_amount           Decimal?                @db.Decimal(12, 2)
  currency               Currency                @default(IDR)
  confirmed_at           DateTime?               @db.Timestamp(6)
  cancelled_at           DateTime?               @db.Timestamp(6)
  completed_at           DateTime?               @db.Timestamp(6)
  rejected_at            DateTime?               @db.Timestamp(6)
  source                 BookingSource           @default(direct)
  referral_code          String?
  utm_source             String?
  utm_medium             String?
  utm_campaign           String?
  created_at             DateTime                @default(now()) @db.Timestamp(6)
  updated_at             DateTime                @default(now()) @db.Timestamp(6)
  booking_requests       booking_requests?       @relation("booking_request_to_booking", fields: [booking_request_id], references: [id], onUpdate: NoAction, map: "bookings_booking_request_id_booking_requests_id_fk")
  group_bookings         group_bookings?         @relation(fields: [group_booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bookings_group_booking_id_group_bookings_id_fk")
  seasonal_pricing_rules seasonal_pricing_rules? @relation(fields: [pricing_rule_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bookings_pricing_rule_id_seasonal_pricing_rules_id_fk")
  properties             properties              @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bookings_property_id_properties_id_fk")
  units                  units                   @relation("unit_bookings", fields: [unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bookings_unit_id_units_id_fk")
  users                  users?                  @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "bookings_user_id_users_id_fk")
  payment_transactions   payment_transactions[]
  payments               payments[]
  refund_requests        refund_requests[]
  reviews                reviews[]
  current_unit           units?                  @relation("unit_current_booking")
  user_contracts         user_contracts[]

  @@index([group_booking_id])
  @@index([is_group_booking])
  @@index([property_id, status, start_date, end_date], map: "bookings_property_availability_idx")
  @@index([property_id])
  @@index([property_id, status, created_at], map: "bookings_property_status_created_idx")
  @@index([status])
  @@index([unit_id])
  @@index([user_id])
  @@index([user_id, status, created_at], map: "bookings_user_status_created_idx")
}

model campus_areas {
  campus_area_id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campus_area_slug           String   @unique(map: "campus_areas_campus_area_slug_unique")
  campus_area_name           String
  campus_area_image_key      String
  campus_area_property_count Int      @default(0)
  campus_area_sort_order     Int      @default(0)
  campus_area_is_active      Boolean  @default(true)
  campus_area_created_at     DateTime @default(now()) @db.Timestamp(6)
  campus_area_updated_at     DateTime @default(now()) @db.Timestamp(6)
}

model chart_of_accounts {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_code            String              @unique(map: "chart_of_accounts_account_code_unique")
  account_name            String
  account_type            AccountType
  is_active               Boolean?            @default(true)
  parent_account_id       String?             @db.Uuid
  chart_of_accounts       chart_of_accounts?  @relation("chart_of_accountsTochart_of_accounts", fields: [parent_account_id], references: [id], onUpdate: NoAction, map: "chart_of_accounts_parent_account_id_chart_of_accounts_id_fk")
  other_chart_of_accounts chart_of_accounts[] @relation("chart_of_accountsTochart_of_accounts")
}

model chat_rooms {
  id                                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_id                       String     @db.Uuid
  tenant_id                         String?    @db.Uuid
  owner_id                          String?    @db.Uuid
  last_message_at                   DateTime?  @db.Timestamp(6)
  created_at                        DateTime   @default(now()) @db.Timestamp(6)
  updated_at                        DateTime   @default(now()) @db.Timestamp(6)
  users_chat_rooms_owner_idTousers  users?     @relation("chat_rooms_owner_idTousers", fields: [owner_id], references: [id], onUpdate: NoAction, map: "chat_rooms_owner_id_users_id_fk")
  properties                        properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_rooms_property_id_properties_id_fk")
  users_chat_rooms_tenant_idTousers users?     @relation("chat_rooms_tenant_idTousers", fields: [tenant_id], references: [id], onUpdate: NoAction, map: "chat_rooms_tenant_id_users_id_fk")
  messages                          messages[]

  @@unique([tenant_id, owner_id], map: "chat_rooms_tenant_owner_unique")
  @@index([last_message_at])
  @@index([owner_id])
  @@index([property_id])
  @@index([tenant_id])
}

model damage_reports {
  id                                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspection_id                           String             @db.Uuid
  item_id                                 String?            @db.Uuid
  reported_by                             String             @db.Uuid
  severity                                Severity
  description                             String
  estimated_cost                          Decimal?           @db.Decimal(12, 2)
  actual_cost                             Decimal?           @db.Decimal(12, 2)
  status                                  DamageReportStatus @default(reported)
  resolution                              String?
  resolved_by                             String?            @db.Uuid
  resolved_at                             DateTime?          @db.Timestamp(6)
  created_at                              DateTime?          @default(now()) @db.Timestamp(6)
  inspections                             inspections        @relation(fields: [inspection_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "damage_reports_inspection_id_inspections_id_fk")
  inspection_items                        inspection_items?  @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "damage_reports_item_id_inspection_items_id_fk")
  users_damage_reports_reported_byTousers users              @relation("damage_reports_reported_byTousers", fields: [reported_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "damage_reports_reported_by_users_id_fk")
  users_damage_reports_resolved_byTousers users?             @relation("damage_reports_resolved_byTousers", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "damage_reports_resolved_by_users_id_fk")
}

model experiment_assignments {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?      @db.Uuid
  variant       String
  assigned_at   DateTime     @default(now()) @db.Timestamp(6)
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  updated_at    DateTime     @default(now()) @db.Timestamp(6)
  experiment_id String?      @db.Uuid
  experiments   experiments? @relation(fields: [experiment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "experiment_assignments_experiment_id_experiments_id_fk")
  users         users?       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "experiment_assignments_user_id_users_id_fk")

  @@unique([user_id, experiment_id], map: "experiment_assignments_user_experiment_unique")
  @@index([experiment_id], map: "idx_experiment_assignments_experiment")
  @@index([user_id], map: "idx_experiment_assignments_user")
}

model experiments {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  status                 ExperimentStatus         @default(draft)
  variants               Json
  metrics                Json
  start_date             DateTime?                @db.Timestamp(6)
  end_date               DateTime?                @db.Timestamp(6)
  created_at             DateTime                 @default(now()) @db.Timestamp(6)
  updated_at             DateTime                 @default(now()) @db.Timestamp(6)
  experiment_assignments experiment_assignments[]

  @@index([status], map: "idx_experiments_status")
}

model favorites {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String     @db.Uuid
  property_id String     @db.Uuid
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @default(now()) @db.Timestamp(6)
  properties  properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "favorites_property_id_properties_id_fk")
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "favorites_user_id_users_id_fk")

  @@unique([user_id, property_id], map: "favorites_user_property_unique")
  @@index([property_id])
  @@index([user_id])
}

model feature_flags {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String   @unique(map: "feature_flags_key_idx")
  name               String
  description        String?
  enabled            Boolean  @default(false)
  rollout_percentage Int      @default(100)
  allowedRoles       String[] @default([])
  allowedUsers       String[] @default([]) @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @db.Timestamp(6)
}

model feedbacks {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?          @db.Uuid
  category   FeedbackCategory
  message    String
  rating     Int?
  status     FeedbackStatus   @default(pending)
  created_at DateTime         @default(now()) @db.Timestamp(6)
  updated_at DateTime         @default(now()) @db.Timestamp(6)
  users      users?           @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "feedbacks_user_id_users_id_fk")

  @@index([category])
  @@index([status])
  @@index([user_id])
}

model general_ledger {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_date DateTime @db.Timestamp(6)
  account_code     String
  account_name     String
  description      String
  reference_type   String?
  reference_id     String?
  debit            Decimal? @default(0) @db.Decimal(12, 2)
  credit           Decimal? @default(0) @db.Decimal(12, 2)
  balance          Decimal? @db.Decimal(12, 2)
  created_by       String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @default(now()) @db.Timestamp(6)
  users            users?   @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "general_ledger_created_by_users_id_fk")

  @@index([created_by])
}

model group_booking_members {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_booking_id String         @db.Uuid
  user_id          String         @db.Uuid
  share_percentage Decimal        @db.Decimal(5, 2)
  share_amount     Decimal        @db.Decimal(12, 2)
  paid_amount      Decimal?       @default(0) @db.Decimal(12, 2)
  status           MemberStatus   @default(invited)
  joined_at        DateTime?      @db.Timestamp(6)
  created_at       DateTime       @default(now()) @db.Timestamp(6)
  updated_at       DateTime       @default(now()) @db.Timestamp(6)
  group_bookings   group_bookings @relation(fields: [group_booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "group_booking_members_group_booking_id_group_bookings_id_fk")
  users            users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "group_booking_members_user_id_users_id_fk")

  @@unique([group_booking_id, user_id], map: "group_booking_members_group_booking_id_user_id_unique")
  @@index([group_booking_id])
  @@index([status])
}

model group_bookings {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_user_id          String                  @db.Uuid
  property_id           String                  @db.Uuid
  unit_id               String                  @db.Uuid
  status                GroupBookingStatus      @default(pending)
  total_amount          Decimal                 @db.Decimal(12, 2)
  deposit_amount        Decimal                 @db.Decimal(12, 2)
  start_date            DateTime                @db.Timestamp(6)
  end_date              DateTime                @db.Timestamp(6)
  metadata              Json?                   @default("{}")
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  updated_at            DateTime?               @default(now()) @db.Timestamp(6)
  bookings              bookings[]
  group_booking_members group_booking_members[]
  users                 users                   @relation(fields: [lead_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "group_bookings_lead_user_id_users_id_fk")
  properties            properties              @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "group_bookings_property_id_properties_id_fk")
  units                 units                   @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "group_bookings_unit_id_units_id_fk")

  @@index([created_at])
  @@index([lead_user_id])
  @@index([property_id])
  @@index([status])
}

model inspection_items {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspection_id     String              @db.Uuid
  category          InspectionCategory
  item_name         String
  condition         Condition?
  notes             String?
  repair_cost       Decimal?            @db.Decimal(12, 2)
  photo_urls        Json?               @default("[]")
  is_new_damage     Boolean?            @default(false)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  damage_reports    damage_reports[]
  inspections       inspections         @relation(fields: [inspection_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "inspection_items_inspection_id_inspections_id_fk")
  inspection_photos inspection_photos[]
}

model inspection_photos {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspection_id    String            @db.Uuid
  item_id          String?           @db.Uuid
  type             PhotoType
  url              String
  caption          String?
  metadata         Json?             @default("{}")
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  inspections      inspections       @relation(fields: [inspection_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "inspection_photos_inspection_id_inspections_id_fk")
  inspection_items inspection_items? @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "inspection_photos_item_id_inspection_items_id_fk")
}

model inspection_templates {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_type PropertyType
  items         Json
  is_default    Boolean?     @default(false)
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
}

model inspections {
  id                                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id                            String              @db.Uuid
  property_id                           String              @db.Uuid
  unit_id                               String              @db.Uuid
  type                                  InspectionType
  status                                InspectionStatus?   @default(pending)
  performed_by                          String              @db.Uuid
  witness_id                            String?             @db.Uuid
  overall_condition                     Condition?
  notes                                 String?
  damage_score                          Decimal?            @db.Decimal(5, 2)
  estimated_repair_cost                 Decimal?            @db.Decimal(12, 2)
  security_deposit                      Decimal?            @db.Decimal(12, 2)
  refund_amount                         Decimal?            @db.Decimal(12, 2)
  is_disputed                           Boolean?            @default(false)
  dispute_reason                        String?
  completed_at                          DateTime?           @db.Timestamp(6)
  created_at                            DateTime?           @default(now()) @db.Timestamp(6)
  damage_reports                        damage_reports[]
  inspection_items                      inspection_items[]
  inspection_photos                     inspection_photos[]
  users_inspections_performed_byTousers users               @relation("inspections_performed_byTousers", fields: [performed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inspections_performed_by_users_id_fk")
  properties                            properties          @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "inspections_property_id_properties_id_fk")
  units                                 units               @relation(fields: [unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "inspections_unit_id_units_id_fk")
  users_inspections_witness_idTousers   users?              @relation("inspections_witness_idTousers", fields: [witness_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inspections_witness_id_users_id_fk")
}

model kyc_verifications {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String?       @db.Uuid
  didit_session_id   String?       @unique(map: "kyc_verifications_didit_session_id_unique")
  didit_redirect_url String?
  status             KycStatus     @default(MENUNGGU)
  document_type      DocumentType?
  ktp_image_url      String?
  selfie_image_url   String?
  face_match_score   Decimal?      @db.Decimal(5, 2)
  liveness_passed    Boolean?
  rejection_reason   String?
  created_at         DateTime      @default(now()) @db.Timestamp(6)
  updated_at         DateTime      @default(now()) @db.Timestamp(6)
  users              users?        @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "kyc_verifications_user_id_users_id_fk")

  @@index([didit_session_id])
  @@index([status])
  @@index([user_id])
}

model loyalty_transactions {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?                @db.Uuid
  amount         Int
  type           LoyaltyTransactionType
  description    String
  reference_id   String?                @db.Uuid
  reference_type String?
  expires_at     DateTime?              @db.Timestamp(6)
  created_at     DateTime               @default(now()) @db.Timestamp(6)
  updated_at     DateTime               @default(now()) @db.Timestamp(6)
  users          users?                 @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "loyalty_transactions_user_id_users_id_fk")

