    "framer-motion": "^13.2.0",
    "install": "^0.13.0",
    "lucide-react": "^1.39.0",
    "maplibre-gl": "^6.7.0",
    "midtrans-client": "^1.4.3",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "prisma": "^7.4.2",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.87.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
